  "title": "input: fall back to last caret for IME candidate bounds before repaint (#3286)",
  "user": {
    "login": "Yi-111-a",
    "id": 153097222,
    "node_id": "U_kgDOCSAUBg",
    "avatar_url": "https://avatars.githubusercontent.com/u/153097222?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/Yi-111-a",
