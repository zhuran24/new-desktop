{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "namespaces": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "version",
        "namespaces"
      ]
    },
    {
      "type": "object",
      "properties": {
        "since": {
          "anyOf": [
            {
              "$ref": "#/$defs/Cursor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stream": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "subscribe"
        }
      },
      "required": [
        "type",
        "stream"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "page": {
          "$ref": "#/$defs/PageReq"
        },
        "res": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "get"
        }
      },
      "required": [
        "type",
        "id",
        "res",
        "page"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "command"
        }
      },
      "required": [
        "type",
        "id",
        "name"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/Command"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "execute"
        }
      },
      "required": [
        "type",
        "id",
        "command"
      ]
    },
    {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string"
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "receipt"
        }
      },
      "required": [
        "type",
        "id",
        "command_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "bye"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "unknown"
        }
      },
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "Command": {
      "description": "id 在守护进程内全局唯一；device 是来源标识，本机权限仍由 socket uid 决定。",
      "type": "object",
      "properties": {
        "args": true,
        "device": {
          "type": "string"
        },
        "expect": true,
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "device",
        "name",
        "args",
        "expect"
      ]
    },
    "Cursor": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "epoch",
        "seq"
      ]
    },
    "PageReq": {
      "type": "object",
      "properties": {
        "before": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "limit"
      ]
    }
  }
}
