{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_Model",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Model"
  },
  "$defs": {
    "Model": {
      "description": "后端实时给出的模型选项；value 原样用于 session.create，不从显示名称推导。",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "label",
        "description",
        "disabled"
      ]
    }
  }
}
