{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string"
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "version",
        "epoch",
        "namespaces"
      ]
    },
    {
      "type": "object",
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "type": {
          "type": "string",
          "const": "snapshot"
        }
      },
      "required": [
        "type",
        "snapshot"
      ]
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "required": [
        "type",
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        },
        "stream": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "resumed"
        }
      },
      "required": [
        "type",
        "stream",
        "epoch",
        "cursor"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "reply"
        },
        "value": true
      },
      "required": [
        "type",
        "id",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/CommandReply"
        },
        "type": {
          "type": "string",
          "const": "command_reply"
        }
      },
      "required": [
        "type",
        "id",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "result": {
          "$ref": "#/$defs/ReceiptLookup"
        },
        "type": {
          "type": "string",
          "const": "receipt_reply"
        }
      },
      "required": [
        "type",
        "id",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "resume": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "bye"
        }
      },
      "required": [
        "type",
        "resume"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "unknown"
        }
      },
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "CommandReply": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "receipt": {
              "$ref": "#/$defs/Receipt"
            },
            "status": {
              "type": "string",
              "const": "receipt"
            }
          },
          "required": [
            "status",
            "receipt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "conflict"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "明确未受理、没有新收据，只有这一种情况可自动同 id 重试。",
          "type": "object",
          "properties": {
            "code": {
              "anyOf": [
                {
                  "$ref": "#/$defs/UnavailableCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "description": "仅同步副本产生：断线后查不到收据，不能自动重发正文。",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "delivery_unknown"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "A newer peer returned a status this version does not interpret.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "other"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stream": {
          "type": "string"
        },
        "upsert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        }
      },
      "required": [
        "stream",
        "epoch",
        "cursor",
        "upsert",
        "remove"
      ]
    },
    "Fallback": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "text"
      ]
    },
    "Item": {
      "type": "object",
      "properties": {
        "data": true,
        "fallback": {
          "$ref": "#/$defs/Fallback"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "namespace",
        "kind",
        "data",
        "fallback"
      ]
    },
    "Receipt": {
      "description": "提交时的永久结论，后续操作进度不能改写已签发的收据。",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "done"
            },
            "value": true
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "description": "起了一个要等的操作。`stream`：能看到它进度的流（例如新建会话的 `session/<id>`）；只加不改的可选字段。",
          "type": "object",
          "properties": {
            "op": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "accepted"
            },
            "stream": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "op"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "now": true,
            "status": {
              "type": "string",
              "const": "rejected"
            }
          },
          "required": [
            "status",
            "code",
            "now"
          ]
        },
        {
          "type": "object",
          "properties": {
            "now": true,
            "status": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "status",
            "now"
          ]
        },
        {
          "description": "A newer peer returned a status this version does not interpret.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "other"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "ReceiptLookup": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "conflict"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "receipt": {
              "$ref": "#/$defs/Receipt"
            },
            "status": {
              "type": "string",
              "const": "found"
            }
          },
          "required": [
            "status",
            "receipt"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "missing"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "expired"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "description": "A newer peer returned a status this version does not interpret.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "other"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "stream",
        "epoch",
        "cursor",
        "items"
      ]
    },
    "UnavailableCode": {
      "type": "string",
      "enum": [
        "recovering",
        "unknown"
      ]
    }
  }
}
