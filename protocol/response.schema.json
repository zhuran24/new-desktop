{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "string"
        },
        "namespaces": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "type": {
          "type": "string",
          "const": "hello"
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "version",
        "epoch",
        "namespaces"
      ]
    },
    {
      "type": "object",
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "type": {
          "type": "string",
          "const": "snapshot"
        }
      },
      "required": [
        "type",
        "snapshot"
      ]
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/Event"
        },
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "required": [
        "type",
        "event"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        },
        "stream": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "resumed"
        }
      },
      "required": [
        "type",
        "stream",
        "epoch",
        "cursor"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "reply"
        },
        "value": true
      },
      "required": [
        "type",
        "id",
        "value"
      ]
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "code",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "resume": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "bye"
        }
      },
      "required": [
        "type",
        "resume"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "unknown"
        }
      },
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "Event": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stream": {
          "type": "string"
        },
        "upsert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        }
      },
      "required": [
        "stream",
        "epoch",
        "cursor",
        "upsert",
        "remove"
      ]
    },
    "Fallback": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "text"
      ]
    },
    "Item": {
      "type": "object",
      "properties": {
        "data": true,
        "fallback": {
          "$ref": "#/$defs/Fallback"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "namespace",
        "kind",
        "data",
        "fallback"
      ]
    },
    "Snapshot": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "epoch": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "stream": {
          "type": "string"
        }
      },
      "required": [
        "stream",
        "epoch",
        "cursor",
        "items"
      ]
    }
  }
}
